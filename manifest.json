{
  "manifest_version": 3,
  "name": "LanguageTool Spellcheck",
  "version": "3.0.0",
  "description": "Inline spellcheck and grammar checking using a local LanguageTool server.",
  "minimum_chrome_version": "119",
  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "css": ["content/styles.css"],
    "js": ["content/boot.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{
    "resources": ["content/*.js"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "LanguageTool Spellcheck",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
