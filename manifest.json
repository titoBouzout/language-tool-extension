{
  "manifest_version": 3,
  "name": "LanguageTool Spellcheck",
  "version": "2.0.0",
  "description": "Inline spellcheck and grammar checking using a local LanguageTool server.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "css": ["content/styles.css"],
    "js": [
      "content/settings.js",
      "content/api.js",
      "content/mirror.js",
      "content/overlay.js",
      "content/ce.js",
      "content/replace.js",
      "content/popup.js",
      "content/main.js"
    ],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "LanguageTool Spellcheck",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
